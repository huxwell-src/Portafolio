---
// Hero.astro — Sección principal con nombre animado, rol, bio y links de contacto
---

<section id="hero" class="hero-section">
  <div class="hero-inner">
    <!-- Etiqueta superior editorial -->
    <p class="hero-eyebrow reveal">
      <span class="mono muted">Portfolio · 2026</span>
    </p>

    <!-- Nombre — elemento hero tipográfico -->
    <h1 class="hero-name reveal reveal-delay-1">
      <span class="name-part">Nicolás</span>
      <span class="name-part name-accent">Sánchez</span>
      <span class="name-part">Berríos</span>
    </h1>

    <!-- Rol -->
    <p class="hero-role reveal reveal-delay-2" data-hero="role">
      Ingeniero en Informática · Backend · Data · Frontend
    </p>

    <!-- Separador de acento -->
    <div class="hero-rule reveal reveal-delay-3" aria-hidden="true"></div>

    <!-- Bio -->
    <p class="hero-bio reveal reveal-delay-3" data-hero="bio">
      Ingeniero en Informática con experiencia en desarrollo backend, análisis
      funcional y automatización de procesos. Perfil técnico-analítico que se
      adapta a distintos roles — desde API REST hasta dashboards — siempre
      orientado a la calidad y la mejora continua.
    </p>

    <!-- Links de contacto rápido -->
    <div class="hero-links reveal reveal-delay-4">
      <a
        href="https://github.com/nicolassanchez"
        target="_blank"
        rel="noopener noreferrer"
        class="hero-link"
        aria-label="GitHub"
      >
        <!-- GitHub SVG icon -->
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>

      <a
        href="https://linkedin.com/in/nicolassanchez"
        target="_blank"
        rel="noopener noreferrer"
        class="hero-link"
        aria-label="LinkedIn"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
        <span>LinkedIn</span>
      </a>

      <a
        href="mailto:nicolas@email.com"
        class="hero-link hero-link-accent"
        aria-label="Email"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span>nicolas@email.com</span>
      </a>
    </div>

    <!-- CTA scroll indicator -->
    <div class="scroll-hint reveal reveal-delay-5" aria-hidden="true">
      <span class="scroll-line"></span>
      <span class="mono muted" style="font-size:0.65rem;letter-spacing:0.15em;"
        >SCROLL</span
      >
    </div>
  </div>

  <!-- Background decoration: big faded number -->
  <div class="hero-bg-deco" aria-hidden="true">01</div>
</section>

<script>
  // i18n hero texts
  const heroTexts: Record<string, Record<string, string>> = {
    es: {
      role: "Ingeniero en Informática · Backend · Data · Frontend",
      bio: "Ingeniero en Informática con experiencia en desarrollo backend, análisis funcional y automatización de procesos. Perfil técnico-analítico que se adapta a distintos roles — desde API REST hasta dashboards — siempre orientado a la calidad y la mejora continua.",
    },
    en: {
      role: "Software Engineer · Backend · Data · Frontend",
      bio: "Software Engineer with experience in backend development, functional analysis, and process automation. A technical-analytical profile that adapts to different roles — from REST APIs to dashboards — always focused on quality and continuous improvement.",
    },
  };
  window.addEventListener("langChange", (e: any) => {
    const { lang } = e.detail;
    document.querySelectorAll("[data-hero]").forEach((el) => {
      const key = el.getAttribute("data-hero")!;
      (el as HTMLElement).innerText =
        heroTexts[lang]?.[key] ?? (el as HTMLElement).innerText;
    });
  });
</script>

<style>
  .hero-section {
    min-height: 100svh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-top: var(--nav-h);
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg);
    width: 100%;
    position: relative;
    z-index: 1;
  }

  /* Eyebrow */
  .hero-eyebrow {
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: var(--space-lg);
    color: var(--text-muted);
  }

  /* Hero name — tipográfico principal */
  .hero-name {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 0.95;
    font-weight: 400;
    margin-bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: 0.05em;
  }

  .name-part {
    display: block;
    letter-spacing: -0.02em;
  }

  /* El apellido con underline de acento animado */
  .name-accent {
    position: relative;
    display: inline-block;
    color: var(--text);
  }

  .name-accent::after {
    content: "";
    position: absolute;
    bottom: 4px;
    left: 0;
    width: 0;
    height: 4px;
    background: var(--accent);
    transition: width 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s;
  }

  /* Trigger underline cuando el elemento se vuelve visible */
  .hero-name.visible .name-accent::after {
    width: 100%;
  }

  /* Rol */
  .hero-role {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: var(--space-lg);
  }

  /* Separador */
  .hero-rule {
    width: 3rem;
    height: 1px;
    background: var(--accent);
    margin-bottom: var(--space-lg);
  }

  /* Bio */
  .hero-bio {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.8;
    color: var(--text-muted);
    max-width: 52ch;
    margin-bottom: var(--space-xl);
  }

  /* Contact links */
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--text-muted);
    transition:
      border-color 0.2s,
      color 0.2s,
      background 0.2s;
  }

  .hero-link:hover {
    border-color: var(--accent);
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }

  .hero-link-accent {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--text);
  }

  /* Scroll hint */
  .scroll-hint {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .scroll-line {
    display: block;
    width: 1.5rem;
    height: 1px;
    background: var(--text-muted);
    animation: scrollPulse 2.5s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%,
    100% {
      width: 1.5rem;
      opacity: 0.4;
    }
    50% {
      width: 3rem;
      opacity: 1;
    }
  }

  /* Background decoration */
  .hero-bg-deco {
    position: absolute;
    right: -0.1em;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-size: clamp(8rem, 20vw, 24rem);
    font-weight: 400;
    color: transparent;
    -webkit-text-stroke: 1px var(--border);
    line-height: 1;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  @media (max-width: 768px) {
    .hero-inner {
      padding: var(--space-xl) var(--space-md);
    }
    .hero-bg-deco {
      display: none;
    }
    .hero-links {
      flex-direction: column;
    }
    .hero-link {
      width: fit-content;
    }
  }
</style>
