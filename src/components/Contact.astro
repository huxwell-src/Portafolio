---
// Contact.astro — Sección de contacto con título con personalidad, links y formulario
---

<section id="contact" class="section">
  <div class="contact-inner">
    <!-- Section label -->
    <div class="section-header reveal">
      <p class="section-label">
        07 — <span data-contact-label="subtitle">Abierto a conversaciones</span>
      </p>
      <h2 class="section-title contact-title" data-contact-label="title">
        ¿Hablamos?
      </h2>
    </div>

    <p
      class="contact-subtitle reveal reveal-delay-1"
      data-contact-label="caption"
    >
      Abierto a oportunidades, proyectos y conversaciones interesantes.
    </p>

    <!-- Quick contact links -->
    <div class="contact-links reveal reveal-delay-2">
      <a
        href="mailto:nicolassanchezberrios@gmail.com"
        class="contact-link contact-link-email"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span style="font-size: 0.9em">nicolassanchezberrios@gmail.com</span>
      </a>

      <a
        href="https://linkedin.com/in/nicolassanchez"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-link"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
        <span>LinkedIn</span>
      </a>

      <a
        href="https://github.com/nicolassanchez"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-link"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>
    </div>

    <!-- Optional form -->
    <form
      class="contact-form reveal reveal-delay-3"
      id="contact-form"
      action="https://formsubmit.co/nicolassanchezberrios@gmail.com"
      method="POST"
    >
      <input type="hidden" name="_subject" value="Nuevo mensaje desde tu Portafolio">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_template" value="box">
      
      <div class="form-row">
        <div class="form-group">
          <label for="cf-name" data-contact-label="formName">Nombre</label>
          <input
            type="text"
            id="cf-name"
            name="name"
            placeholder="Tu nombre"
            autocomplete="name"
            required
          />
        </div>
        <div class="form-group">
          <label for="cf-email" data-contact-label="formEmail">Email</label>
          <input
            type="email"
            id="cf-email"
            name="email"
            placeholder="tu@email.com"
            autocomplete="email"
            required
          />
        </div>
      </div>
      <div class="form-group">
        <label for="cf-message" data-contact-label="formMessage">Mensaje</label>
        <textarea
          id="cf-message"
          name="message"
          rows="5"
          placeholder="Cuéntame de tu proyecto o propuesta..."
          required></textarea>
      </div>
      <button type="submit" class="btn-submit" data-contact-label="formSend">
        Enviar mensaje
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
        </svg>
      </button>
    </form>
  </div>
</section>

<script>
  // Simple AJAX form handling using FormSubmit
  const form = document.getElementById("contact-form") as HTMLFormElement;
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      // Basic client-side validation
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const btn = form.querySelector(".btn-submit") as HTMLButtonElement;
      if (!btn) return;
      
      const originalHtml = btn.innerHTML;
      btn.textContent = "Enviando...";
      btn.disabled = true;

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          btn.textContent = "✓ Mensaje enviado";
          btn.style.borderColor = "var(--accent-1)";
          btn.style.color = "var(--accent-1)";
          form.reset();
        } else {
          throw new Error("Server response wasn't OK");
        }
      } catch (err) {
        btn.textContent = "✕ Error al enviar";
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.disabled = false;
        }, 3000);
      }
    });
  }

  const contactLabels: Record<string, Record<string, string>> = {
    es: {
      title: "¿Hablamos?",
      subtitle: "Abierto a conversaciones",
      caption:
        "Abierto a oportunidades, proyectos y conversaciones interesantes.",
      formName: "Nombre",
      formEmail: "Email",
      formMessage: "Mensaje",
      formSend: "Enviar mensaje",
    },
    en: {
      title: "Let's talk",
      subtitle: "Open to conversations",
      caption:
        "Open to opportunities, projects, and interesting conversations.",
      formName: "Name",
      formEmail: "Email",
      formMessage: "Message",
      formSend: "Send message",
    },
  };

  window.addEventListener("langChange", (e: any) => {
    const { lang } = e.detail;
    const l = contactLabels[lang];
    document.querySelectorAll("[data-contact-label]").forEach((el) => {
      const k = el.getAttribute("data-contact-label")!;
      if (l[k]) (el as HTMLElement).textContent = l[k];
    });
    // Update placeholders
    const nameInput = document.getElementById("cf-name") as HTMLInputElement;
    const emailInput = document.getElementById("cf-email") as HTMLInputElement;
    const msgInput = document.getElementById(
      "cf-message",
    ) as HTMLTextAreaElement;
    if (nameInput)
      nameInput.placeholder = lang === "en" ? "Your name" : "Tu nombre";
    if (emailInput)
      emailInput.placeholder = lang === "en" ? "you@email.com" : "tu@email.com";
    if (msgInput)
      msgInput.placeholder =
        lang === "en"
          ? "Tell me about your project or proposal..."
          : "Cuéntame de tu proyecto o propuesta...";
  });
</script>

<style>
  .contact-inner {
    max-width: 720px;
  }

  .contact-title {
    font-size: clamp(2.5rem, 7vw, 5rem);
  }

  .contact-subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-xl);
    margin-top: var(--space-sm);
  }

  /* Contact links */
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: all 0.2s;
  }

  .contact-link:hover {
    border-color: var(--accent);
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    transform: translateY(-2px);
  }

  .contact-link-email {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--text);
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .form-group input,
  .form-group textarea {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--bg-alt);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    width: 100%;
    resize: vertical;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
    outline: none;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: var(--text);
    color: var(--bg);
    border: 1px solid var(--text);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.05em;
    align-self: flex-start;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }

  .btn-submit:hover:not(:disabled) {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .btn-submit:disabled {
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .form-row {
      grid-template-columns: 1fr;
    }
    .contact-links {
      flex-direction: column;
    }
    .contact-link {
      width: 100%;
    }
  }
</style>
